  <modelVersion>4.0.0</modelVersion>
  <groupId>com.octetproof</groupId>
  <artifactId>sdk</artifactId>
  <version>1.2.1</version>
  <packaging>aar</packaging>
  <name>octetSDK</name>
  <description>octet SDK for Android.</description>
