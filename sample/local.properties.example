# Octet SDK sample — local configuration (gitignored; your edits stay local).
#
# 1. Copy this file to `local.properties` in the same directory.
# 2. Set octet.activationServerUrl (below), then build on a real device.
#
# How activation works (2.0.0): the SDK activates by *attesting the device* — on
# a real device it uses hardware key attestation and bootstraps its licence
# automatically. There is no license key to paste.
#
# This sample is PROD-ONLY: run it on a real device with a hardware-backed
# keystore. An emulator / CI can't produce production attestation; the SDK's
# sandbox-bootstrap path for those is covered in the repository's INTEGRATION.md,
# but is intentionally not wired into this sample. Sign up at https://octetproof.com.
#
# The build reads these here first, then falls back to the multi-project root
# (octet-sdk/android/local.properties).

# Still REQUIRED by OctetConfig, but as of 2.0.0 NOT the activation credential —
# the SDK activates by attestation, not by this value. Leave as-is unless Octet
# issued you a specific one.
octet.licenseKey=octet_live_PLACEHOLDER_NOT_USED_FOR_ACTIVATION

# Activation server URL. Default = production. Override when running against your
# own activation backend. API 28+ blocks cleartext to non-loopback hosts by
# default — use https, or add a network-security-config exception for the host.
octet.activationServerUrl=https://api.octetproof.com

# (Optional) Google Cloud project NUMBER for Play Integrity. Adds a Play Integrity
# verdict to generated proofs — NOT required to activate (activation uses hardware
# key attestation). To use it, create a project in the Google Cloud console, link
# it to your Play Console app, and put its project NUMBER (not the ID) here. Leave
# commented out to build without Play Integrity.
#   octet.playIntegrityCloudProjectNumber=123456789012
